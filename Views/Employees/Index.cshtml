@{
    ViewData["Title"] = "Employees";
}

@model EmployeesIndexViewModel

<div class="employees-index">
    <div class="employees-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="umbrella-title h4 mb-0 text-uppercase fw-bold">Personnel Directory</h1>
        @if (Model.CreateMode)
        {
            <a class="btn btn-outline-secondary" asp-controller="Employees" asp-action="Index">Cancel</a>
        }
        else
        {
            <a class="btn btn-umbrella" asp-controller="Employees" asp-action="Index" asp-route-createMode="true">Create Employee</a>
        }
    </div>
    @if (Model.CreateMode)
    {
        <div class="card shadow-sm">
            <div class="card-header fw-semibold text-uppercase small">New Employee</div>
            <div class="card-body">
                <partial name="_EmployeeForm" model="new CreateEditEmployeeDto()"></partial>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="employees-table table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Department</th>
                            @if (!User.IsInRole(Role.Admin))
                            {
                                <th>Annual Leave Left</th>
                                <th>Employment Type</th>
                                <th>Employment Status</th>
                            }
                            @if (User.IsInRole(Role.Admin))
                            {
                                <th>Heart Rate</th>
                                <th>Current Location</th>
                                <th>Infection Status</th>
                                <th>Life Status</th>
                            }
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.EmployeeTable.Employees)
                        {
                            <tr>
                                <td class="fw-semibold">@employee.Name</td>
                                <td>@employee.Department</td>
                                @if (!User.IsInRole(Role.Admin))
                                {
                                    <td>@employee.AnnualLeaveLeft</td>
                                    <td>@employee.EmploymentType</td>
                                    <td>@employee.EmploymentStatus</td>
                                }
                                @if (User.IsInRole(Role.Admin))
                                {
                                    <td>@employee.HeartRate</td>
                                    <td>@employee.CurrentLocation</td>
                                    <td>@employee.InfectionStatus</td>
                                    <td>@employee.LifeStatus</td>
                                }
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-dark" asp-controller="Employees" asp-action="Details" asp-route-Id="@employee.Id">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <nav class="mt-3" aria-label="Employee list pages">
            <ul class="pagination pagination-umbrella justify-content-center flex-wrap mb-0">
                @for (int i = 0; i < (int)Math.Ceiling(Model.EmployeeTable.TotalEmployeeCount / (double)10); i++)
                {
                    <li class="page-item @((i + 1) == Model.CurrentPage ? "selected" : "")">
                        <a class="page-link" asp-controller="Employees" asp-action="Index" asp-route-page="@(i + 1)">@(i + 1)</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
