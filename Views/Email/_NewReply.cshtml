@model ReplyEmailDto

<form asp-controller="Email" asp-action="ReplyEmail" class="d-flex flex-column gap-2">
    <input type="hidden" asp-for="Id" />
    <input asp-for="Subject" class="form-control form-control-sm" placeholder="Subject" />
    <span asp-validation-for="Subject" class="text-danger small"></span>
    <textarea asp-for="Body" class="form-control" name="Body" rows="3" placeholder="Write a reply..." aria-label="Reply"></textarea>
    <span asp-validation-for="Body" class="text-danger small"></span>
    <div class="text-end">
        <button class="btn btn-sm btn-umbrella" type="submit">Send</button>
    </div>
</form>
