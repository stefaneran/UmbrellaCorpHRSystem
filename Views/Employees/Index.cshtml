@model ICollection<EmployeeTableRowViewModel>

<div class="container">
    <div class="employees-toolbar"></div>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                @if (!User.IsInRole(Role.Admin))
                {
                    <th>Annual Leave Left</th>
                    <th>Employment Type</th>
                    <th>Employment Status</th>
                }
                @if (User.IsInRole(Role.Admin))
                {
                    <th>Heart Rate</th>
                    <th>Current Location</th>
                    <th>Infection Status</th>
                    <th>Life Status</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Department</td>
                    @if (!User.IsInRole(Role.Admin))
                    {
                        <th>@employee.AnnualLeaveLeft</th>
                        <th>@employee.EmploymentType</th>
                        <th>@employee.EmploymentStatus</th>
                    }
                    @if (User.IsInRole(Role.Admin))
                    {
                        <th>@employee.HeartRate</th>
                        <th>@employee.CurrentLocation</th>
                        <th>@employee.InfectionStatus</th>
                        <th>@employee.LifeStatus</th>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>