@model int

<form asp-controller="Email" asp-action="ReplyEmail" class="d-flex flex-column gap-2">
    <input type="hidden" name="ThreadId" value="@Model" />
    <label class="visually-hidden" for="reply-subject">Subject</label>
    <input class="form-control form-control-sm" id="reply-subject" type="text" name="Subject" placeholder="Subject" />
    <textarea class="form-control" name="Body" rows="3" placeholder="Write a reply..." aria-label="Reply"></textarea>
    <div class="text-end">
        <button class="btn btn-sm btn-umbrella" type="submit">Send</button>
    </div>
</form>
