@model ICollection<EmployeeTableRowViewModel>

<div class="container">
    <div class="employees-toolbar"></div>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                @if (!User.IsInRole(Role.Admin))
                {
                    <th>Annual Leave Left</th>
                    <th>Employment Type</th>
                    <th>Employment Status</th>
                }
                @if (User.IsInRole(Role.Admin))
                {
                    <th>Heart Rate</th>
                    <th>Current Location</th>
                    <th>Infection Status</th>
                    <th>Life Status</th>
                }
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Department</td>
                    @if (!User.IsInRole(Role.Admin))
                    {
                        <td>@employee.AnnualLeaveLeft</td>
                        <td>@employee.EmploymentType</td>
                        <td>@employee.EmploymentStatus</td>
                    }
                    @if (User.IsInRole(Role.Admin))
                    {
                        <td>@employee.HeartRate</td>
                        <td>@employee.CurrentLocation</td>
                        <td>@employee.InfectionStatus</td>
                        <td>@employee.LifeStatus</td>
                    }
                    <td>
                        <a asp-controller="Employees" asp-action="Details" asp-route-Id="@employee.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>