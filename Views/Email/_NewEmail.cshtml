
<form asp-controller="Email" asp-action="SendEmail" class="container">
    <input type="hidden" name="SenderEmail" value="claireredfield@umbrellacorp.com" />
    <div class="row">
        <label class="col">To:</label>
        <input class="col" type="email" name="RecipientEmail" value="@Model?.RecipientEmail" />
    </div>
    <div class="row">
        <label class="col">Subject:</label>
        <input class="col" type="text" name="Subject" />
    </div>
    
    <textarea name="Body"></textarea>
    <button type="submit">Send</button>
</form>
