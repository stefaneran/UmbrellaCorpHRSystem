
<form asp-controller="Email" asp-action="SendEmail" class="d-flex flex-column gap-3 h-100 p-4">
    <h2 class="h5 mb-0 text-uppercase fw-bold">New Message</h2>
    <div class="row g-2 align-items-center">
        <label class="col-sm-2 col-form-label fw-semibold" for="new-email-recipient">To</label>
        <div class="col-sm-10">
            <input class="form-control" id="new-email-recipient" type="email" name="RecipientEmail" value="@Model?.RecipientEmail" />
        </div>
    </div>
    <div class="row g-2 align-items-center">
        <label class="col-sm-2 col-form-label fw-semibold" for="new-email-subject">Subject</label>
        <div class="col-sm-10">
            <input class="form-control" id="new-email-subject" type="text" name="Subject" />
        </div>
    </div>
    <textarea class="form-control flex-grow-1" name="Body" rows="10" placeholder="Write your message..." aria-label="Message"></textarea>
    <div class="text-end">
        <button class="btn btn-umbrella" type="submit">Send</button>
    </div>
</form>
