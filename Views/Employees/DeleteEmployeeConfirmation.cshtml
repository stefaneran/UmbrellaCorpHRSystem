@{
    ViewData["Title"] = "Delete Confirmation";
}

@model DeleteEmployeeConfirmationViewModel

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-umbrella">
            <div class="card-header text-bg-umbrella fw-bold text-uppercase small">Termination of Employee Record</div>
            <div class="card-body">
                <h1 class="h5 mb-2">You are about to delete @Model.Name as an employee. Are you sure?</h1>
                <p class="text-muted small">This action is permanent and cannot be undone.</p>
                <form class="d-flex justify-content-end gap-2 mb-0" asp-controller="Employees" asp-action="DeleteEmployee">
                    <input type="hidden" asp-for="Id" />
                    <a class="btn btn-outline-secondary" asp-controller="Employees" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                    <button type="submit" class="btn btn-umbrella">!!! Delete Employee !!!</button>
                </form>
            </div>
        </div>
    </div>
</div>
