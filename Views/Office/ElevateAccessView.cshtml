@{
    ViewData["Title"] = "Elevate Access";
}

@model ElevateAccessDto

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-umbrella">
            <div class="card-header text-bg-umbrella-dark fw-bold text-uppercase small">Umbrella Corporation &middot; Restricted Terminal</div>
            <div class="card-body">
                <h1 class="umbrella-title h5 text-uppercase fw-bold mb-3">FAILSAFE PROTOCOL: Elevate Access to Admin Role</h1>
                <div class="alert alert-danger py-2 mb-3" role="alert">
                    <h2 class="h6 fw-bold mb-0">Warning: Can only be done in emergencies</h2>
                </div>

                <form class="mb-0" asp-controller="Office" asp-action="ElevateAccess">
                    <label class="form-label fw-semibold small text-uppercase" for="Password">Authorization Code</label>
                    <div class="input-group">
                        <input 
                            asp-for="Password" 
                            type="password"
                            disabled="@User.IsInRole(Role.Admin)"
                            class="form-control" 
                            autocomplete="off" 
                            placeholder="Password" />
                        <button 
                            class="btn btn-umbrella fw-bold text-uppercase" 
                            type="submit" 
                            disabled="@User.IsInRole(Role.Admin)">Elevate</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </form>
            </div>
        </div>

        @if (User.IsInRole(Role.Admin))
        {
            <div class="d-flex justify-content-between align-items-center border-top mt-4 pt-3">
                <span class="small text-uppercase text-muted fw-semibold">Debug</span>
                <form class="mb-0" asp-controller="Office" asp-action="DowngradeAccess">
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Debug: Downgrade</button>
                </form>
            </div>
        }
    </div>
</div>
