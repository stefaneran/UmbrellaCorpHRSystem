@model EmailThreadViewModel

<div class="email-thread-toolbar">
    <form asp-controller="Email" asp-action="DeleteThread">
        <input type="hidden" name="Id" value="@Model.Id" />
        <button class="btn btn-danger" type="submit">Delete Thread</button>
    </form>
</div>
<div class="email-thread-messages">
    @foreach(var emailMessage in Model.Messages)
    {
        <div class="email-thread-message">
            <div class="email-thread-message-header">
                <p>From: @emailMessage.SenderEmail</p>
                <p>To: @emailMessage.RecipientEmail</p>
                <p>Subject: @emailMessage.Subject</p>
            </div>
            <div class="email-thread-message-body">
                <p>@emailMessage.Body</p>
            </div>
        </div>
    }
</div>
<div class="email-thread-reply-form">
    <partial name="_NewReply" model="Model.Id"></partial>
</div>
